NODE_ID=opticnode-1
REDIS_URL=redis://redis:6379
GRPC_HOST=[::]
GRPC_PORT=50051
HEARTBEAT_INTERVAL_S=1.0
HEARTBEAT_TTL_S=10
LOG_BUFFER_SIZE=100
PRIMOCACHE_EXE=rxpcc.exe
GUI_MODE=false

# Optional: override NIC classification (psutil link speed)
# MGMT_IFACE=eth0
# DATA_IFACE=eth1

# Optional: IP/hostname the hub uses for gRPC ping (default: management plane IP)
# ADVERTISED_HOST=192.168.1.50

# GitHub Releases auto-update (Windows frozen .exe). Set GITHUB_REPO to enable checks.
# GITHUB_REPO=myorg/opticstream
# AUTO_UPDATE=true
# UPDATE_CHECK_INTERVAL_S=3600
# UPDATER_ASSET_PATTERN=opticnode*.exe
